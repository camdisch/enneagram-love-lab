@@ -0,0 +1,130 @@
+import { createFileRoute, Link } from "@tanstack/react-router";
+import { ArrowLeft } from "lucide-react";
+
+import { Button } from "@/components/ui/button";
+import { BUNDLE, SINGLE, SUPPORT_EMAIL } from "@/lib/product";
+
+/**
+ * Privacy, terms and refunds — on one page, deliberately short.
+ *
+ * ⚠️ THIS PAGE IS A PREREQUISITE FOR PAID TRAFFIC, NOT A NICE-TO-HAVE.
+ * Meta and Google both require a reachable privacy policy and a stated
+ * refund policy before they will run a commerce campaign, and Stripe asks
+ * for the same when a dispute lands. Missing them is a common reason a new
+ * ad account gets restricted in its first week — after the money is spent.
+ *
+ * It is written to be true of the site as it actually behaves today. If you
+ * ever add email capture, analytics, or a server, this page has to change
+ * with it — a privacy policy that describes the wrong product is worse than
+ * none, because it is a written claim you are not honouring.
+ */
+export const Route = createFileRoute("/legal")({
+  head: () => ({
+    meta: [
+      { title: "Privacy, terms & refunds" },
+      { name: "description", content: "How this site handles your data, and how refunds work." },
+    ],
+  }),
+  component: Legal,
+});
+
