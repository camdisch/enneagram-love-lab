+
+/**
+ * Record a completed payment that has no result to attach to yet.
+ *
+ * Called when Stripe hands back a session id but this browser has no pending
+ * purchase. The buyer is sent to take (or retake) a test, and the credit is
+ * spent the moment they land on a results page.
+ */
+export function grantCredit(session: string): void {
+  const current = read() ?? blank();
+  if (current.sessions.includes(session)) return; // already banked this payment
+  current.credits += 1;
+  current.sessions.push(session);
+  write(current);
+}
+
+/** Is there a paid-for unlock waiting to be attached to a result? */
+export function hasCredit(): boolean {
+  return (read()?.credits ?? 0) > 0;
+}
+
+/**
+ * Spend one credit on this relationship. Returns true if one was available,
+ * in which case the manual is now theirs and the paywall must not be shown.
+ */
+export function redeemCredit(slug: string): boolean {
+  const current = read();
+  if (!current || current.credits <= 0) return false;
+  current.credits -= 1;
+  if (!current.singles.includes(slug)) current.singles.push(slug);
+  write(current);
+  return true;
+}
