new file mode 100644
index 0000000..844ade1
--- /dev/null
+++ b/src/lib/track.ts
@@ -0,0 +1,74 @@
+/**
+ * Funnel events, fired into whatever analytics happens to be on the page.
+ *
+ * WHY THIS EXISTS
+ * ---------------
+ * You cannot buy traffic for a funnel you cannot measure. Without a
+ * conversion event, Meta and Google are optimising for *clicks*, not
+ * *buyers* — you pay full price for the worst possible audience and the
+ * algorithm never learns who converts. That is the single most expensive
+ * mistake available to a paid-ads business, and it costs nothing to avoid.
+ *
+ * HOW TO SWITCH IT ON
+ * -------------------
+ * Paste your Meta Pixel and/or GA4 snippet into index.html (or Lovable's
+ * project settings). Nothing here needs to change: these calls no-op until
+ * a pixel exists, and start reporting the moment one does.
+ *
+ * The important one is `checkoutStarted` — mark it as your conversion
+ * event, and (once Stripe webhooks exist) fire a real Purchase server-side.
+ * Until then this measures INTENT, not revenue: treat the numbers as a
+ * ceiling, not a result.
+ */
+
+type Props = Record<string, string | number | boolean | undefined>;
+
+interface Trackers {
+  fbq?: (kind: string, event: string, props?: Props) => void;
+  gtag?: (kind: string, event: string, props?: Props) => void;
+  dataLayer?: Props[];
+}
+
+function w(): Trackers | null {
+  return typeof window === "undefined" ? null : (window as unknown as Trackers);
+}
+
+/** Fire one funnel event everywhere that is listening. Never throws. */
+export function track(event: string, props: Props = {}): void {
+  const win = w();
+  if (!win) return;
+  try {
+    win.fbq?.("trackCustom", event, props);
+    win.gtag?.("event", event, props);
+    win.dataLayer?.push({ event, ...props });
+    if (import.meta.env?.DEV) console.info("[track]", event, props);
+  } catch {
+    // Analytics must never break a checkout.
+  }
+}
+
+/** Landing page seen. */
+export const landingViewed = () => track("landing_viewed");
+
+/** They committed to a test — the first real signal of intent. */
+export const quizStarted = (relationship: string) => track("quiz_started", { relationship });
+
+/** They answered all twelve. This is the audience worth retargeting. */
+export const quizCompleted = (relationship: string) => track("quiz_completed", { relationship });
+
+/** The paywall was actually seen (not just the quiz finished). */
+export const offerViewed = (relationship: string) => track("offer_viewed", { relationship });
+
+/**
+ * They clicked through to Stripe. Mark THIS as the optimisation event until a
+ * server-side purchase event exists — it is the closest proxy you have.
+ */
+export const checkoutStarted = (relationship: string, tier: string) =>
+  track("checkout_started", { relationship, tier });
+
+/** They came back from Stripe with a session id and got the file. */
+export const purchaseConfirmed = (relationship: string, tier: string) =>
+  track("purchase_confirmed", { relationship, tier });
+
+/** They paid but we could not match them to a result — watch this number. */
+export const purchaseOrphaned = () => track("purchase_orphaned");
